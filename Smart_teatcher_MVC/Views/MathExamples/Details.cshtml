@model Smart_teatcher_MVC.Models.MathExample

@{
    ViewData["Title"] = "تفاصيل العملية الحسابية";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-sm-6">
                <h1 class="m-0">تفاصيل العملية الحسابية</h1>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-end">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-right ms-1"></i>
                        العودة للقائمة
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="math-operation-large">
                            @Model.Num1 @Html.DisplayFor(m => m.ArithmeticOperations) @Model.Num2
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="info-group mb-4">
                                <label class="text-muted">خطوات الحل</label>
                                <div class="solution-steps">
                                    @foreach (var step in Model.Steps)
                                    {
                                        <div class="step">
                                            <i class="fas fa-chevron-left me-2"></i>
                                            @step
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-group mb-3">
                                <label class="text-muted">المستوى</label>
                                <p class="mb-0">@Model.Level</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="info-group mb-3">
                                <label class="text-muted">تاريخ الإنشاء</label>
                                <p class="mb-0">@Model.CreatedAt.ToString("yyyy/MM/dd")</p>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                            <i class="fas fa-edit ms-1"></i>
                            تعديل
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="fas fa-trash-alt ms-1"></i>
                            حذف
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .math-operation-large {
            font-size: 2.5rem;
            font-weight: bold;
            color: #2c3e50;
            background-color: #f8f9fa;
            padding: 2rem;
            border-radius: 12px;
            display: inline-block;
            margin-bottom: 1rem;
        }

        .solution-steps {
            background-color: #f8f9fa;
            border-radius: 10px;
            padding: 1rem;
        }

        .step {
            padding: 0.5rem 0;
            border-bottom: 1px solid #dee2e6;
        }

        .step:last-child {
            border-bottom: none;
        }

        .info-group label {
            font-size: 0.875rem;
            margin-bottom: 0.25rem;
            display: block;
        }
    </style>
}
