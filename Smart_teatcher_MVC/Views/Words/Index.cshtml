@model IEnumerable<Smart_teatcher_MVC.Models.Word>
@using Smart_teatcher_MVC.Extensions

@{
    ViewData["Title"] = "الكلمات";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-sm-6">
                <h1 class="m-0">الكلمات</h1>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-end">
                    @if (User.HasPermission("CanAddWords"))
                    {
                        <a asp-action="Create" class="btn btn-primary" data-permission="CanAddWords">
                            <i class="fas fa-plus ms-1"></i>
                            إضافة كلمة جديدة
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-1">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="word-text">
                                @item.Text
                            </div>
                            <span class="badge bg-@(GetLevelClass(item.Level))">@GetLevelInArabic(item.Level)</span>
                        </div>
                        @if (item.Image != null)

                        {
                            <img src="data:image/png;base64,@Convert.ToBase64String(item.Image)"
                                 class="card-img-top p-3"
                                 alt="@item.Text"
                                 style="height: 200px; object-fit: contain;" />
                        }

                        else

                        {
                            <div class="text-center p-3">
                                <i class="fas fa-image fa-4x text-muted"></i>
                            </div>
                        }
                        <div class="text-muted small mb-3">
                            <i class="fas fa-calendar-alt me-1"></i>
                            @item.CreatedAt.ToString("dd/MM/yyyy")
                        </div>

                        <div class="card-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2">
                                <i class="fas fa-eye ms-1"></i>
                                تفاصيل
                            </a>
                            @if (User.HasPermission("CanEditWords"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success me-2" data-permission="CanEditWords">
                                    <i class="fas fa-edit ms-1"></i>
                                    تعديل
                                </a>
                            }
                            @if (User.HasPermission("CanDeleteWords"))
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" data-permission="CanDeleteWords">
                                    <i class="fas fa-trash-alt ms-1"></i>
                                    حذف
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .word-text {
            font-size: 1.5rem;
            font-weight: bold;
        }

        .card-actions {
            display: flex;
            justify-content: flex-start;
            align-items: center;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('a[data-permission]').on('click', function (e) {
                var action = $(this).attr('href').split('/').pop().split('?')[0];
                var checkPermission = false;

                switch (action) {
                    case 'Edit':
                        checkPermission = !@(User.HasPermission("CanEditWords").ToString().ToLower());
                        break;
                    case 'Delete':
                        checkPermission = !@(User.HasPermission("CanDeleteWords").ToString().ToLower());
                        break;
                    case 'Create':
                        checkPermission = !@(User.HasPermission("CanAddWords").ToString().ToLower());
                        break;
                }

                if (checkPermission) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'عذراً',
                        text: 'ليس لديك صلاحية للقيام بهذه العملية',
                        icon: 'warning',
                        confirmButtonText: 'حسناً'
                    });
                }
            });
        });
    </script>
}

@functions {
    private string GetLevelInArabic(Smart_teatcher_MVC.Models.Level level)
    {
        return level switch
        {
            Smart_teatcher_MVC.Models.Level.Beginner => "مبتدئ",
            Smart_teatcher_MVC.Models.Level.Intermediate => "متوسط",
            Smart_teatcher_MVC.Models.Level.Advanced => "متقدم",
            _ => level.ToString()
        };
    }

    private string GetLevelClass(Smart_teatcher_MVC.Models.Level level)
    {
        return level switch
        {
            Smart_teatcher_MVC.Models.Level.Beginner => "success",
            Smart_teatcher_MVC.Models.Level.Intermediate => "warning",
            Smart_teatcher_MVC.Models.Level.Advanced => "danger",
            _ => "primary"
        };
    }
}
