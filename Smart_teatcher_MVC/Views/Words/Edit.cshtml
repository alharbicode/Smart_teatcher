@model Smart_teatcher_MVC.Models.Word

@{
    ViewData["Title"] = "تعديل الكلمة";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-sm-6">
                <h1 class="m-0">تعديل الكلمة</h1>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-end">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-right ms-1"></i>
                        العودة للقائمة
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        
                        <div class="mb-3">
                            <div class="form-group">
                                <label asp-for="Text" class="form-label">نص الكلمة</label>
                                <input asp-for="Text" class="form-control" />
                                <span asp-validation-for="Text" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-group">
                                <label asp-for="Level" class="form-label">المستوى</label>
                                <select asp-for="Level" class="form-select">
                                    <option value="Beginner">مبتدئ</option>
                                    <option value="Intermediate">متوسط</option>
                                    <option value="Advanced">متقدم</option>
                                </select>
                                <span asp-validation-for="Level" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-group">
                                <label asp-for="Image" class="form-label">صورة الكلمة</label>
                                <input type="file" name="imageFile" class="form-control" accept="image/*" />
                                @if (Model.Image != null)
                                {
                                    <div class="mt-2">
                                        <img src="data:image/png;base64,@Convert.ToBase64String(Model.Image)" class="img-thumbnail" style="max-width: 200px;" />
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save ms-1"></i>
                                حفظ التغييرات
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            $('.form-control, .form-select').addClass('rounded-3');
        });
    </script>
}
