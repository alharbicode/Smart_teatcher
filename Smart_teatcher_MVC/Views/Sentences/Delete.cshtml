@model Smart_teatcher_MVC.Models.Sentence

@{
    ViewData["Title"] = "حذف الجملة";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-sm-6">
                <h1 class="m-0">حذف الجملة</h1>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-end">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-right ms-1"></i>
                        العودة للقائمة
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="alert alert-danger mb-4">
                        <h5 class="alert-heading">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            تأكيد الحذف
                        </h5>
                        <p class="mb-0">هل أنت متأكد من رغبتك في حذف هذه الجملة؟</p>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="info-group">
                                <label class="text-muted">نص الجملة</label>
                                <p class="mb-0">@Model.Text</p>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="info-group">
                                <label class="text-muted">المستوى</label>
                                <p class="mb-0">@Model.Level</p>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="info-group">
                                <label class="text-muted">تاريخ الإنشاء</label>
                                <p class="mb-0">@Model.CreatedAt.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <form asp-action="DeleteConfirmed" method="post" class="mt-4">
                            <input type="hidden" asp-for="Id" />
                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-right ms-1"></i>
                                    عودة للقائمة
                                </a>
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash ms-1"></i>
                                    تأكيد الحذف
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 15px;
            border: none;
        }
        .sentence-content {
            background-color: rgba(0, 123, 255, 0.05);
            padding: 2rem;
            border-radius: 15px;
            text-align: center;
        }
        .detail-item {
            background-color: #f8f9fa;
            padding: 1rem;
            border-radius: 10px;
            height: 100%;
        }
        .detail-item label {
            display: block;
            margin-bottom: 0.5rem;
        }
        .detail-item h4 {
            margin: 0;
        }
        .badge {
            font-size: 1rem;
            padding: 0.5rem 1rem;
        }
        .btn {
            padding: 0.5rem 1.5rem;
            border-radius: 10px;
        }
        .alert {
            border-radius: 10px;
        }
    </style>
}
