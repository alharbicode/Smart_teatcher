@model Smart_teatcher_MVC.Models.Sentence

@{
    ViewData["Title"] = "تعديل الجملة";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-sm-6">
                <h1 class="m-0">تعديل الجملة</h1>
            </div>
            <div class="col-sm-6">
                <div class="float-sm-end">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-right ms-1"></i>
                        العودة للقائمة
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />
                        
                        <div class="mb-4">
                            <label asp-for="Text" class="form-label fw-bold">نص الجملة</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-quote-right"></i></span>
                                <textarea asp-for="Text" class="form-control" rows="3" 
                                    placeholder="أدخل نص الجملة هنا..." required></textarea>
                            </div>
                            <span asp-validation-for="Text" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Level" class="form-label fw-bold">المستوى</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-layer-group"></i></span>
                                <select asp-for="Level" class="form-select" required>
                                    <option value="">اختر المستوى...</option>
                                    <option value="Beginner">مبتدئ</option>
                                    <option value="Intermediate">متوسط</option>
                                    <option value="Advanced">متقدم</option>
                                </select>
                            </div>
                            <span asp-validation-for="Level" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-5">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-right ms-1"></i>
                                عودة للقائمة
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save ms-1"></i>
                                حفظ التغييرات
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 15px;
            border: none;
        }
        .form-control, .form-select, .input-group-text {
            border-radius: 10px;
        }
        .input-group > :not(:first-child) {
            border-top-left-radius: 10px;
            border-bottom-left-radius: 10px;
        }
        .input-group > :not(:last-child) {
            border-top-right-radius: 10px;
            border-bottom-right-radius: 10px;
        }
        .btn {
            padding: 0.5rem 1.5rem;
            border-radius: 10px;
        }
        textarea.form-control {
            min-height: 100px;
        }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // تفعيل التحقق من صحة النموذج
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()
    </script>
    <script>
        $(document).ready(function() {
            $('.form-control, .form-select').addClass('rounded-3');
        });
    </script>
}
